node_modules/

# Local brainstorming screens and session credentials.
.superpowers/

# A real browser profile, created by the header live-audit tooling. It holds
# "Login Data", "Web Data", "Secure Preferences" and a BraveWallet directory —
# saved passwords, autofill and wallet state. It is 114 MB and this repo is
# public. Never commit it.
build-tools/header-live-profile/

# Generated renders. `npm run fixtures` rewrites these on every run.
build-tools/fixtures/

# Scratch from measurement/render harnesses.
build-tools/.tmp-*
build-tools/_tmp-*
build-tools/*.tmp.*

# Not project source — business/legal docs, not generated by any tool here.
output/

# Scratch output from the probe/test harnesses (screenshots, captured bundles).
tmp/
*.cpuprofile

# Release zips. `npm run package` rebuilds them from an allowlist.
release/

# Developer handoff material (native-render kit, technical handover, feature
# packages, spec PDFs, bug reports). Kept locally, never in the repository:
# the reskin's main stays the extension only (Curtis, 2026-10-05). The live
# native-render workspace is Desktop/idleworlds-native-handoff.
dev-handoff/
