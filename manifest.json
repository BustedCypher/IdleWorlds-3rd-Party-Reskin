{
  "manifest_version": 3,
  "name": "IdleWorlds Fantasy Skin",
  "version": "1.7.0",
  "description": "Independent Legacy and Fantasy reskin profiles for IdleWorlds, with a theme selector and reversible presentation.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://idleworlds.com/*",
    "https://www.idleworlds.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://idleworlds.com/*",
        "https://www.idleworlds.com/*"
      ],
      "js": [
        "dist/content.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://idleworlds.com/*",
        "https://www.idleworlds.com/*"
      ],
      "js": [
        "src/page/hydration-signal.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/skills-ui/buttons/revised-v5/*.png",
        "assets/skills-ui/buttons/card-v6/*.png",
        "assets/skills-ui/buttons/compact-ghost-v3/*.png"
      ],
      "matches": [
        "https://idleworlds.com/*",
        "https://www.idleworlds.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "IdleWorlds Skin Settings",
    "default_popup": "src/options/options.html"
  }
}
